{
  "expo": {
    "name": "KOBANIQ",
    "slug": "app-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kobaniq.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.kobaniq.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      "expo-localization",
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1E3A5F",
          "defaultChannel": "default"
        }
      ]
    ],
    "scheme": "kobaniq",
    "extra": {
      "eas": {
        "projectId": "436d6922-0f04-473f-84bf-87e956ba98bc"
      }
    },
    "owner": "abdisalam-mohamed"
  }
}
