# Copy to .env and put your computer's Wi-Fi IPv4 address (run `ipconfig`).
# The phone and the computer must be on the same Wi-Fi.

# Backend API base URL used by the app
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api/v1

# Optional, for Expo Go: put this line in .env.local (Expo refuses it in .env)
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.10
