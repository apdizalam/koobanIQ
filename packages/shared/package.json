{
  "name": "@kobaniq/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared KOBANIQ types, constants and translations (en/so) used by the mobile app, admin, landing and server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "i18n"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/check-i18n.mjs",
    "i18n:sync": "node scripts/check-i18n.mjs --sync",
    "i18n:release": "node scripts/check-i18n.mjs --release"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
