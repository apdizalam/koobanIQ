{
  "name": "backend",
  "version": "1.0.0",
  "description": "KOBANIQ API server (Node.js, Express, TypeScript, MongoDB Atlas)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --import ./test/support/setup.ts --test test/**/*.test.ts",
    "db:check": "tsx src/scripts/db-check.ts",
    "admin:promote": "tsx src/scripts/make-admin.ts",
    "admin:super": "tsx src/scripts/make-super-admin.ts",
    "ai:check": "tsx src/scripts/ai-check.ts",
    "ai:check:jd": "tsx test/live/jdLiveCheck.ts",
    "ai:check:cv": "tsx test/live/cvLiveCheck.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^3.6.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
