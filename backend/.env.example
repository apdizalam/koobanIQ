# KOBANIQ backend environment variables.
# Copy to .env and fill in real values. Never commit .env.

# HTTP port for the API
PORT=5000

# development | test | staging | production
NODE_ENV=development

# MongoDB Atlas connection string (MONGO_URI is also accepted)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Optional: override the database name (defaults: kobaniq_dev / kobaniq_test / kobaniq_staging / kobaniq_prod)
MONGODB_DB_NAME=

# Secret for signing access tokens (a long random string).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Token lifetimes (defaults: 15m access, 30 days refresh)
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30

# Email (verification and password-reset codes) via Resend: https://resend.com
# Leave empty in development: the emails, with their codes, are printed in the
# backend terminal instead. Required in staging and production.
RESEND_API_KEY=
# Sender. "onboarding@resend.dev" only delivers to your own Resend account email;
# to email any user, verify your domain in Resend and use e.g. KOBANIQ <no-reply@yourdomain>
EMAIL_FROM=KOBANIQ <onboarding@resend.dev>
