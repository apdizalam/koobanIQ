# KOBANIQ backend environment variables.
# Copy to .env and fill in real values. Never commit .env.

# HTTP port for the API
PORT=5000

# Proxies in front of the server: 0 when run directly (development),
# 1 behind a host's proxy such as Render (staging / production).
TRUST_PROXY=0

# development | test | staging | production
NODE_ENV=development

# MongoDB Atlas connection string (MONGO_URI is also accepted)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Optional: override the database name (defaults: kobaniq_dev / kobaniq_test / kobaniq_staging / kobaniq_prod)
MONGODB_DB_NAME=

# Secret for signing access tokens (a long random string).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Token lifetimes (defaults: 15m access, 30 days refresh)
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30

# Email (verification and password-reset codes) via Resend: https://resend.com
# Leave empty in development: the emails, with their codes, are printed in the
# backend terminal instead. Required in staging and production.
RESEND_API_KEY=
# Sender. "onboarding@resend.dev" only delivers to your own Resend account email;
# to email any user, verify your domain in Resend and use e.g. KOBANIQ <no-reply@yourdomain>
EMAIL_FROM=KOBANIQ <onboarding@resend.dev>
# Error alerts (server errors, crashes, AI outages) and "someone joined the waitlist"
# emails go to this address; empty = off.
# With Resend's test sender it must be your Resend account's own email.
# Test it: npm run alert:test -w backend
ALERT_EMAIL=
# Optional: at most one alert email per kind of problem in this time (ms, 15 min)
ALERT_COOLDOWN_MS=900000
# Ask new users to confirm their email with a code before using the app.
# Off (false) while emails only reach the Resend owner; set true once a domain
# is verified in Resend and codes reach every user.
EMAIL_VERIFICATION_REQUIRED=false
# Email notifications for new strong job matches (TIQ-22). Keep false until a
# Resend domain is verified; push and in-app notifications work without it.
NOTIFICATION_EMAILS_ENABLED=false

# AI features (job descriptions, CVs, quizzes, match explanations, interviews).
# Provider: Google Gemini API free tier (development). Create a key at
# https://aistudio.google.com without enabling billing. Server only: never put
# it in the mobile app. Free-tier prompts may be used by Google to improve its
# products and read by reviewers: test with synthetic data only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Planned shutdown no earlier than 2027-05-07; Google's replacement: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite
# Second Gemini model (same key) tried when the main one is overloaded (503),
# rate limited or too slow. Empty = none. 2026-11-24: 3.1 Flash-Lite answered
# "high demand" for 25+ minutes while 3.5 Flash-Lite answered at once.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# How much Gemini "thinks" before answering: minimal | low | medium | high, or
# empty for the model's default (slower). Our tasks are structured: low.
GEMINI_THINKING_LEVEL=low
# Optional: longest wait for one AI answer (ms; quiz, CV and interview allow 60 s,
# job descriptions 45 s), AI requests per user per hour
AI_TIMEOUT_MS=30000
AI_USER_REQUESTS_PER_HOUR=30
# Optional: most time one AI request may take with every retry (ms); the app waits 120 s
AI_TOTAL_BUDGET_MS=90000
# Optional: first pause before trying a busy AI again (ms); the second is about 2.5x longer
AI_RETRY_DELAY_MS=2000
# Sending real users' profile data to the AI (CVs) is controlled in the Admin
# Dashboard (Settings → AI privacy), not here: BLOCKED by default; an admin can
# change it with a reason, every change is recorded. Test accounts are marked there too.

# Google sign-in (TIQ-39). Free "Web application" OAuth client from Google Cloud
# Console (APIs & Services > Credentials). Never commit the real values.
# GOOGLE_REDIRECT_URI = this server's public https address + /api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
