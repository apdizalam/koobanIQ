{
  "name": "kobaniq",
  "version": "0.1.0",
  "private": true,
  "description": "KOBANIQ monorepo: mobile app, admin dashboard, landing page, API server and shared package",
  "workspaces": [
    "packages/shared",
    "backend",
    "Admin-dashboard",
    "landing",
    "app-frontend"
  ],
  "scripts": {
    "dev:server": "npm run dev -w backend",
    "dev:admin": "npm run dev -w admin-dashboard",
    "dev:landing": "npm run dev -w landing",
    "dev:mobile": "npm run start -w app-frontend",
    "health": "npm run health -w backend",
    "build": "npm run build --workspaces --if-present",
    "build:web": "node scripts/build-web.mjs",
    "check:web": "node scripts/check-web.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
