# KOBANIQ repo-wide ignores (each app may add its own .gitignore)

# dependencies
node_modules/

# environment files: never commit secrets
.env
.env.*
!.env.example

# build output
dist/
web-dist/
*.tsbuildinfo

# logs and OS files
npm-debug.log*
.DS_Store
Thumbs.db

# Firebase / Google service-account private keys: never in the repository.
# (google-services.json is NOT secret and is committed in app-frontend/.)
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json
